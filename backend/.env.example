# 백엔드(NestJS + Prisma)용. 복사본 .env 는 Git에 올리지 않는다.
# 외부 PostgreSQL 링크(Render 등)를 넣고, 끝에 사용할 스키마를 붙인다.
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=hackathon&sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=hackathon&sslmode=require

# NestJS 포트
PORT=3001

# CORS 허용 Origin (쉼표로 여러 개)
CORS_ORIGIN=http://localhost:3000

# 프론트 주소 (직원 초대 링크에 사용, 없으면 CORS_ORIGIN 첫 값)
FRONTEND_URL=http://localhost:3000

# 초대 메일 발송 (Resend). 비우면 메일 없이 초대 링크만 화면에 표시
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
